---
import type { InferGetStaticPropsType } from 'astro';
import { render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CaseStudy from '../../../components/CaseStudy.astro';
import { localePath, useTranslations } from '../../../i18n/ui';
import { getWork, localizedEntryPaths, slugOf } from '../../../lib/content';

export const getStaticPaths = () => localizedEntryPaths((locale) => getWork(locale));
type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { locale, entry, next } = Astro.props;
const t = useTranslations(locale);
const { Content } = await render(entry);
const { title, summary, role, period, stack, impact, video, poster, company } = entry.data;
const showPeriod = period !== 'TODO' || import.meta.env.DEV;
const meta = [
  { label: t('case.role'), text: role },
  ...(showPeriod ? [{ label: t('case.period'), text: period }] : []),
  { label: t('case.stack'), tags: stack },
];
---

<BaseLayout locale={locale} title={title} description={summary}>
  <CaseStudy
    locale={locale}
    eyebrow={`${t('case.eyebrow')} ${company}`}
    title={title}
    summary={summary}
    note={t('case.note')}
    meta={meta}
    impact={impact}
    video={video}
    poster={poster}
    back={{ href: `${localePath(locale, '/')}#experience`, label: t('case.back') }}
    next={
      next && { href: localePath(locale, `/work/${slugOf(next)}/`), label: next.data.title, kicker: t('case.next') }
    }
    Content={Content}
  />
</BaseLayout>
