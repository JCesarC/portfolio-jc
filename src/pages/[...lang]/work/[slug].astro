---
import { render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CaseStudy from '../../../components/CaseStudy.astro';
import { defaultLocale, localePath, locales, useTranslations, type Locale } from '../../../i18n/ui';
import { getWork, slugOf } from '../../../lib/content';

type Work = Awaited<ReturnType<typeof getWork>>[number];

export async function getStaticPaths() {
  const paths = [];
  for (const locale of locales) {
    const work = await getWork(locale);
    for (const [i, entry] of work.entries()) {
      paths.push({
        params: { lang: locale === defaultLocale ? undefined : locale, slug: slugOf(entry) },
        props: { locale, entry, next: work.length > 1 ? work[(i + 1) % work.length] : undefined },
      });
    }
  }
  return paths;
}

const { locale, entry, next } = Astro.props as { locale: Locale; entry: Work; next?: Work };
const t = useTranslations(locale);
const { Content } = await render(entry);
const { title, summary, role, period, stack, impact, video, poster, company } = entry.data;
const showPeriod = period !== 'TODO' || import.meta.env.DEV;
const meta = [
  { label: t('case.role'), text: role },
  ...(showPeriod ? [{ label: t('case.period'), text: period }] : []),
  { label: t('case.stack'), tags: stack },
];
---

<BaseLayout locale={locale} title={title} description={summary}>
  <CaseStudy
    locale={locale}
    eyebrow={`${t('case.eyebrow')} ${company}`}
    title={title}
    summary={summary}
    meta={meta}
    impact={impact}
    video={video}
    poster={poster}
    back={{ href: `${localePath(locale, '/')}#experience`, label: t('case.back') }}
    next={
      next && { href: localePath(locale, `/work/${slugOf(next)}/`), label: next.data.title, kicker: t('case.next') }
    }
    Content={Content}
  />
</BaseLayout>
