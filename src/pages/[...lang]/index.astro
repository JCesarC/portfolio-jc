---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import WorkCard from '../../components/WorkCard.astro';
import Experience from '../../components/Experience.astro';
import Skills from '../../components/Skills.astro';
import Contact from '../../components/Contact.astro';
import { langPaths, useTranslations, type Locale } from '../../i18n/ui';
import { getWork } from '../../lib/content';

export const getStaticPaths = langPaths;

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);
const work = await getWork(locale);
---

<BaseLayout locale={locale}>
  <Hero locale={locale} />

  <section id="work" class="container-page scroll-mt-20 py-20" aria-labelledby="work-title">
    <SectionHeading id="work" title={t('work.title')} lead={t('work.lead')} />
    <div class="grid gap-6 lg:grid-cols-2">
      {work.map((entry, i) => (
        <div class={i === 0 ? 'lg:col-span-2' : ''}>
          <WorkCard entry={entry} locale={locale} />
        </div>
      ))}
    </div>
  </section>

  <Experience locale={locale} />
  <Skills locale={locale} />
  <Contact locale={locale} />
</BaseLayout>
