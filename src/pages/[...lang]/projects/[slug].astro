---
import type { InferGetStaticPropsType } from 'astro';
import { render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CaseStudy from '../../../components/CaseStudy.astro';
import { localePath, useTranslations } from '../../../i18n/ui';
import { getProjects, localizedEntryPaths, slugOf } from '../../../lib/content';

export const getStaticPaths = () => localizedEntryPaths(getProjects);
type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { locale, entry, next } = Astro.props;
const t = useTranslations(locale);
const { Content } = await render(entry);
const { title, summary, status, stack, impact, video, poster, repo, demo } = entry.data;
const links = [
  ...(demo ? [{ href: demo, label: t('projects.demo') }] : []),
  ...(repo ? [{ href: repo, label: t('projects.repo') }] : []),
];
---

<BaseLayout locale={locale} title={title} description={summary}>
  <CaseStudy
    locale={locale}
    eyebrow={t('project.eyebrow')}
    title={title}
    summary={summary}
    stack={stack}
    status={t(`projects.status.${status}`)}
    impact={impact}
    video={video}
    poster={poster}
    links={links}
    soon={!demo && status === 'building' ? t('projects.soon') : undefined}
    back={{ href: `${localePath(locale, '/')}#projects`, label: t('project.back') }}
    next={
      next && {
        href: localePath(locale, `/projects/${slugOf(next)}/`),
        label: next.data.title,
        kicker: t('project.next'),
      }
    }
    Content={Content}
  />
</BaseLayout>
