---
import { render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CaseStudy from '../../../components/CaseStudy.astro';
import { defaultLocale, localePath, locales, useTranslations, type Locale } from '../../../i18n/ui';
import { getProjects, slugOf } from '../../../lib/content';

type Project = Awaited<ReturnType<typeof getProjects>>[number];

export async function getStaticPaths() {
  const paths = [];
  for (const locale of locales) {
    const projects = await getProjects(locale);
    for (const [i, entry] of projects.entries()) {
      paths.push({
        params: { lang: locale === defaultLocale ? undefined : locale, slug: slugOf(entry) },
        props: { locale, entry, next: projects.length > 1 ? projects[(i + 1) % projects.length] : undefined },
      });
    }
  }
  return paths;
}

const { locale, entry, next } = Astro.props as { locale: Locale; entry: Project; next?: Project };
const t = useTranslations(locale);
const { Content } = await render(entry);
const { title, summary, status, stack, impact, video, poster, repo, demo } = entry.data;
const links = [
  ...(demo ? [{ href: demo, label: t('projects.demo') }] : []),
  ...(repo ? [{ href: repo, label: t('projects.repo') }] : []),
];
---

<BaseLayout locale={locale} title={title} description={summary}>
  <CaseStudy
    locale={locale}
    eyebrow={t('project.eyebrow')}
    title={title}
    summary={summary}
    meta={[
      { label: t('case.status'), text: t(`projects.status.${status}`) },
      { label: t('case.stack'), tags: stack },
    ]}
    impact={impact}
    video={video}
    poster={poster}
    links={links}
    back={{ href: `${localePath(locale, '/')}#projects`, label: t('project.back') }}
    next={
      next && {
        href: localePath(locale, `/projects/${slugOf(next)}/`),
        label: next.data.title,
        kicker: t('project.next'),
      }
    }
    Content={Content}
  />
</BaseLayout>
