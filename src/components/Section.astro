---
/** Home page section with an anchor id and a heading. */
interface Props {
  id: string;
  title: string;
  lead?: string;
}
const { id, title, lead } = Astro.props;
---

<section id={id} class="container-page py-20" aria-labelledby={`${id}-title`}>
  <div class="mb-10 max-w-2xl">
    <h2 id={`${id}-title`} class="font-serif text-3xl font-semibold tracking-tight sm:text-4xl">
      {title}
    </h2>
    {lead && <p class="mt-3 text-(--color-muted)">{lead}</p>}
  </div>
  <slot />
</section>
