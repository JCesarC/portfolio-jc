---
interface Props {
  items: string[];
  label?: string;
  /** `md` for detail pages, where the stack is the only metadata. */
  size?: 'sm' | 'md';
}
const { items, label = 'Stack', size = 'sm' } = Astro.props;
const sizes = { sm: 'px-2.5 py-0.5 text-xs', md: 'px-3 py-1 text-sm' };
---

<ul class="flex flex-wrap gap-1.5" aria-label={label}>
  {items.map((item) => (
    <li class={`rounded-full border border-(--color-line) font-mono text-(--color-muted) ${sizes[size]}`}>{item}</li>
  ))}
</ul>
