---
import { content, site } from '../data';
import { useTranslations, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const { profile } = content(locale);
const cv = site.cv[locale];
const btn = 'inline-flex items-center gap-2 rounded-lg px-4 py-2.5 text-sm font-medium transition-colors';
const secondary = `${btn} border border-(--color-line) hover:bg-(--color-accent-soft)`;
---

<section class="container-page pt-16 pb-20 sm:pt-24 sm:pb-28" aria-labelledby="hero-title">
  <p class="eyebrow">{site.focus}</p>
  <h1
    id="hero-title"
    class="mt-5 font-serif text-4xl leading-[1.05] font-semibold tracking-tight text-balance sm:text-6xl"
  >
    {site.name}
  </h1>
  <p class="mt-3 text-xl text-(--color-accent) sm:text-2xl">{profile.title}</p>
  <p class="mt-6 max-w-2xl text-lg leading-relaxed text-pretty text-(--color-muted)">{profile.intro}</p>
  <p class="mt-3 max-w-2xl leading-relaxed text-pretty text-(--color-muted)">{profile.now}</p>

  <div class="mt-8 flex flex-wrap gap-3">
    <a href={`mailto:${site.email}`} class={`${btn} bg-(--color-ink) text-(--color-bg) hover:opacity-90`}>
      {t('hero.email')}
    </a>
    {cv && (
      <a href={cv} class={secondary} download>
        {t('hero.cv')}
      </a>
    )}
    <a href={site.links.linkedin} rel="me" class={secondary}>
      LinkedIn
    </a>
    <a href={site.links.github} rel="me" class={secondary}>
      GitHub
    </a>
  </div>

  <dl class="mt-14 grid gap-6 border-t border-(--color-line) pt-8 sm:grid-cols-3">
    {profile.highlights.map((h) => (
      <div>
        <dt class="sr-only">{h.label}</dt>
        <dd class="font-serif text-4xl font-semibold text-(--color-ink)">{h.value}</dd>
        <dd class="mt-1 text-sm text-(--color-muted)">{h.label}</dd>
      </div>
    ))}
  </dl>
</section>
