---
import type { CollectionEntry } from 'astro:content';
import Tags from './Tags.astro';
import { localePath, useTranslations, type Locale } from '../i18n/ui';
import { slugOf } from '../lib/content';

interface Props {
  entry: CollectionEntry<'projects'>;
  locale: Locale;
}
const { entry, locale } = Astro.props;
const t = useTranslations(locale);
const href = localePath(locale, `/projects/${slugOf(entry)}/`);
const { title, summary, impact, stack, status, demo } = entry.data;
const soon = !demo && status === 'building';
---

<article class="group relative flex h-full flex-col rounded-2xl border border-(--color-line) bg-(--color-surface) p-6 transition-shadow hover:shadow-lg hover:shadow-black/5 sm:p-8">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <p class="eyebrow">{t(`projects.status.${status}`)}</p>
    {soon && (
      <span class="inline-flex items-center gap-1.5 rounded-full border border-dashed border-(--color-line) px-2.5 py-0.5 text-xs text-(--color-muted)">
        <span aria-hidden="true" class="size-1.5 rounded-full bg-(--color-accent)" />
        {t('projects.soon')}
      </span>
    )}
  </div>
  <h3 class="mt-3 font-serif text-2xl font-semibold tracking-tight">
    <a href={href} class="after:absolute after:inset-0 after:rounded-2xl">
      {title}
    </a>
  </h3>
  <p class="mt-3 text-(--color-muted)">{summary}</p>
  {impact.length > 0 && (
    <dl class="mt-6 grid grid-cols-2 gap-4">
      {impact.map((i) => (
        <div>
          <dt class="sr-only">{i.label}</dt>
          <dd class="font-serif text-2xl font-semibold text-(--color-accent)">{i.value}</dd>
          <dd class="mt-0.5 text-xs text-(--color-muted)">{i.label}</dd>
        </div>
      ))}
    </dl>
  )}
  <div class="mt-6 flex flex-1 items-end justify-between gap-4">
    <Tags items={stack} />
    <span
      aria-hidden="true"
      class="shrink-0 text-sm text-(--color-accent) transition-transform group-hover:translate-x-1"
    >
      {t('projects.read')} →
    </span>
  </div>
</article>
