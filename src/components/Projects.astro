---
import Section from './Section.astro';
import ProjectCard from './ProjectCard.astro';
import Todo from './Todo.astro';
import { localePath, useTranslations, type Locale } from '../i18n/ui';
import { getProjects } from '../lib/content';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const projects = await getProjects(locale);
---

<Section id="projects" title={t('projects.title')} lead={t('projects.lead')}>
  {projects.length > 0 ? (
    <div class="grid gap-6 lg:grid-cols-2">
      {projects.map((entry, i) => (
        <div class={i === 0 && projects.length % 2 === 1 ? 'lg:col-span-2' : ''}>
          <ProjectCard entry={entry} locale={locale} />
        </div>
      ))}
    </div>
  ) : (
    <Todo>Add personal projects in src/content/projects/&lt;locale&gt;/&lt;slug&gt;.mdx before publishing.</Todo>
  )}

  <a
    href={localePath(locale, '/early-projects/')}
    class="group mt-8 flex flex-col gap-4 rounded-2xl border border-dashed border-(--color-line) p-6 transition-colors hover:border-(--color-accent) hover:bg-(--color-accent-soft) sm:flex-row sm:items-center sm:justify-between sm:p-8"
  >
    <span>
      <span class="block font-serif text-xl font-semibold">{t('projects.early.title')}</span>
      <span class="mt-1 block text-sm text-(--color-muted)">{t('projects.early.lead')}</span>
    </span>
    <span class="inline-flex shrink-0 items-center gap-2 self-start rounded-lg border border-(--color-line) bg-(--color-surface) px-4 py-2.5 text-sm font-medium sm:self-auto">
      {t('projects.early.cta')}
      <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">
        →
      </span>
    </span>
  </a>
</Section>
