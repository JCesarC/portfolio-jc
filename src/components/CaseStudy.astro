---
/** Shared detail page body for professional case studies and personal projects. */
import Flow from './Flow.astro';
import Todo from './Todo.astro';
import Tags from './Tags.astro';
import Video from './Video.astro';
import type { render } from 'astro:content';
import { useTranslations, type Locale } from '../i18n/ui';

type Link = { href: string; label: string };

interface Props {
  locale: Locale;
  eyebrow: string;
  title: string;
  summary: string;
  stack: string[];
  /** Project status pill (personal projects only). */
  status?: string;
  impact: { value: string; label: string }[];
  video?: string;
  poster?: string;
  links?: Link[];
  /** Placeholder shown next to the links while a demo is not deployed yet (e.g. "Demo coming soon"). */
  soon?: string;
  /** Small disclaimer under the summary (e.g. company ownership of the product). */
  note?: string;
  back: Link;
  next?: Link & { kicker: string };
  Content: Awaited<ReturnType<typeof render>>['Content'];
}

const {
  locale,
  eyebrow,
  title,
  summary,
  stack,
  status,
  impact,
  video,
  poster,
  links = [],
  soon,
  note,
  back,
  next,
  Content,
} = Astro.props;
const t = useTranslations(locale);
---

<article class="container-page pt-12 pb-8">
  <a href={back.href} class="text-sm text-(--color-muted) hover:text-(--color-ink)">
    ← {back.label}
  </a>

  <header class="mt-8 max-w-3xl">
    <p class="eyebrow">{eyebrow}</p>
    <h1 class="mt-4 font-serif text-4xl leading-tight font-semibold tracking-tight text-balance sm:text-5xl">
      {title}
    </h1>
    <div class="mt-5 flex flex-wrap items-center gap-1.5">
      {status && (
        <span class="rounded-full bg-(--color-accent-soft) px-3 py-1 text-sm font-medium text-(--color-accent)">
          {status}
        </span>
      )}
      <Tags items={stack} label={t('case.stack')} size="md" />
    </div>
    <p class="mt-6 text-lg leading-relaxed text-(--color-muted)">{summary}</p>
    {note && <p class="mt-3 text-xs text-(--color-muted)">{note}</p>}
    {(links.length > 0 || soon) && (
      <ul class="mt-6 flex flex-wrap gap-3">
        {links.map((l) => (
          <li>
            <a
              href={l.href}
              class="inline-flex rounded-lg border border-(--color-line) px-4 py-2 text-sm font-medium hover:bg-(--color-accent-soft)"
            >
              {l.label} ↗
            </a>
          </li>
        ))}
        {soon && (
          <li>
            <span class="inline-flex items-center gap-2 rounded-lg border border-dashed border-(--color-line) px-4 py-2 text-sm text-(--color-muted)">
              <span aria-hidden="true" class="size-1.5 rounded-full motion-safe:animate-pulse bg-(--color-accent)" />
              {soon}
            </span>
          </li>
        )}
      </ul>
    )}
  </header>

  {impact.length > 0 && (
    <section aria-label={t('case.impact')} class="mt-10 grid max-w-3xl gap-4 sm:grid-cols-3">
      {impact.map((i) => (
        <div class="rounded-xl bg-(--color-accent-soft) p-5">
          <p class="font-serif text-3xl font-semibold text-(--color-accent)">{i.value}</p>
          <p class="mt-1 text-sm text-(--color-muted)">{i.label}</p>
        </div>
      ))}
    </section>
  )}

  {video && (
    <div class="mt-10 max-w-3xl">
      <Video src={video} poster={poster} label={`${t('video.label')}: ${title}`} />
    </div>
  )}

  <div class="prose-case prose prose-lg mt-14 max-w-3xl">
    <Content components={{ Flow, Todo }} />
  </div>

  {next && (
    <nav class="mt-16 max-w-3xl border-t border-(--color-line) pt-8" aria-label={next.kicker}>
      <p class="eyebrow">{next.kicker}</p>
      <a href={next.href} class="mt-2 inline-block font-serif text-2xl font-semibold hover:text-(--color-accent)">
        {next.label} →
      </a>
    </nav>
  )}
</article>
