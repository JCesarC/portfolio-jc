---
import Section from './Section.astro';
import Tags from './Tags.astro';
import { localePath, useTranslations, type Locale } from '../i18n/ui';
import { getJobs, slugOf } from '../lib/content';
import { formatPeriod } from '../lib/format';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const jobs = await getJobs(locale);
---

<Section id="experience" title={t('experience.title')}>
  <ol class="space-y-16">
    {jobs.map((job) => (
      <li class="grid gap-4 md:grid-cols-[13rem_1fr] md:gap-10">
        <div class="text-sm text-(--color-muted)">
          <p class="font-mono text-xs">{formatPeriod(job.start, job.end, locale, t('experience.present'))}</p>
          <p class="mt-1">{job.location}</p>
        </div>
        <div class="min-w-0">
          <h3 class="text-lg font-semibold">
            {job.role} <span class="text-(--color-muted)">· {job.company}</span>
          </h3>
          <p class="mt-2 leading-relaxed text-(--color-muted)">{job.context}</p>

          {job.cases.length > 0 && (
            <div class="mt-8">
              <h4 class="eyebrow">{t('experience.key')}</h4>
              <ul class="mt-3 grid gap-3 sm:grid-cols-2">
                {job.cases.map((entry, i) => (
                  <li class={i === 0 && job.cases.length % 2 === 1 ? 'sm:col-span-2' : ''}>
                    <a
                      href={localePath(locale, `/work/${slugOf(entry)}/`)}
                      class="group flex h-full flex-col rounded-xl border border-(--color-line) bg-(--color-surface) p-5 transition-colors hover:border-(--color-accent)"
                    >
                      <span class="font-serif text-lg leading-snug font-semibold">{entry.data.title}</span>
                      <span class="mt-2 text-sm leading-relaxed text-(--color-muted)">{entry.data.summary}</span>
                      <span class="mt-4 flex flex-1 flex-wrap items-end justify-between gap-x-6 gap-y-3">
                        <span class="flex flex-wrap gap-x-5 gap-y-1">
                          {entry.data.impact.map((m) => (
                            <span class="text-sm">
                              <span class="font-semibold text-(--color-accent)">{m.value}</span>
                              <span class="text-(--color-muted)"> {m.label}</span>
                            </span>
                          ))}
                        </span>
                        <span class="shrink-0 text-sm font-medium text-(--color-accent)">
                          {t('experience.read')}{' '}
                          <span aria-hidden="true" class="inline-block transition-transform group-hover:translate-x-1">
                            →
                          </span>
                        </span>
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
              <p class="mt-2 text-xs text-(--color-muted)">{t('experience.cases.note')}</p>
            </div>
          )}

          {job.bullets.length > 0 && (
            <div class="mt-8">
              {job.cases.length > 0 && <h4 class="eyebrow">{t('experience.more')}</h4>}
              <ul class="mt-3 space-y-2.5 leading-relaxed">
                {job.bullets.map((b) => (
                  <li class="relative pl-5 before:absolute before:top-[0.7em] before:left-0 before:size-1.5 before:rounded-full before:bg-(--color-accent)">
                    {b}
                  </li>
                ))}
              </ul>
            </div>
          )}

          <div class="mt-6">
            <Tags items={job.stack} />
          </div>
        </div>
      </li>
    ))}
  </ol>
</Section>
