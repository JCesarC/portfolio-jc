---
import SectionHeading from './SectionHeading.astro';
import Tags from './Tags.astro';
import { education, experience, formatPeriod } from '../data/profile';
import { localePath, useTranslations, type Locale } from '../i18n/ui';
import { getWork, slugOf } from '../lib/content';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const cases = Object.fromEntries(
  await Promise.all(experience.map(async (job) => [job.id, await getWork(locale, job.id)] as const)),
);
---

<section id="experience" class="container-page scroll-mt-20 py-20" aria-labelledby="experience-title">
  <SectionHeading id="experience" title={t('experience.title')} />
  <ol class="space-y-14">
    {experience.map((job) => (
      <li class="grid gap-4 md:grid-cols-[13rem_1fr] md:gap-10">
        <div class="text-sm text-(--color-muted)">
          <p class="font-mono text-xs">{formatPeriod(job.start, job.end, locale, t('experience.present'))}</p>
          <p class="mt-1">{job.location[locale]}</p>
        </div>
        <div>
          <h3 class="text-lg font-semibold">
            {job.role[locale]} <span class="text-(--color-muted)">· {job.company}</span>
          </h3>
          <p class="mt-2 leading-relaxed text-(--color-muted)">{job.context[locale]}</p>
          {job.bullets[locale].length > 0 && (
            <ul class="mt-4 space-y-2.5 leading-relaxed">
              {job.bullets[locale].map((b) => (
                <li class="relative pl-5 before:absolute before:top-[0.7em] before:left-0 before:size-1.5 before:rounded-full before:bg-(--color-accent)">
                  {b}
                </li>
              ))}
            </ul>
          )}
          <div class="mt-5">
            <Tags items={job.stack} />
          </div>
          {cases[job.id].length > 0 && (
            <div class="mt-8">
              <h4 class="eyebrow">{t('experience.cases')}</h4>
              <ul class="mt-3 divide-y divide-(--color-line) rounded-xl border border-(--color-line) bg-(--color-surface)">
                {cases[job.id].map((entry) => (
                  <li>
                    <a
                      href={localePath(locale, `/work/${slugOf(entry)}/`)}
                      class="group flex items-center justify-between gap-4 px-4 py-3.5 transition-colors hover:bg-(--color-accent-soft) sm:px-5"
                    >
                      <span>
                        <span class="block font-medium">{entry.data.title}</span>
                        <span class="mt-0.5 block text-sm text-(--color-muted)">{entry.data.summary}</span>
                      </span>
                      <span
                        aria-hidden="true"
                        class="shrink-0 text-(--color-accent) transition-transform group-hover:translate-x-1"
                      >
                        →
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
              <p class="mt-2 text-xs text-(--color-muted)">{t('experience.cases.note')}</p>
            </div>
          )}
        </div>
      </li>
    ))}
    <li class="grid gap-4 md:grid-cols-[13rem_1fr] md:gap-10">
      <p class="font-mono text-xs text-(--color-muted)">{education.period}</p>
      <h3 class="text-lg font-semibold">
        {education.degree[locale]} <span class="text-(--color-muted)">· {education.school}</span>
      </h3>
    </li>
  </ol>
</section>
